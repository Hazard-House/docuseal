<section class="flex items-center justify-center" style="background: var(--hs-surface-2); min-height: 100vh;">
  <div class="py-10 mx-auto max-w-7xl px-4">
    <div class="max-w-xl mx-auto">
      <div class="text-center">
        <div class="relative flex flex-col items-center">
          <%= render 'shared/logo', width: '80', height: '80' %>
          <h1 class="text-5xl font-bold mt-4 mb-2" style="font-family: var(--bhh-sans); letter-spacing: 0.26em; text-transform: uppercase; color: var(--hs-ink);">
            Brown Haven Homes
          </h1>
          <p style="font-family: var(--bhh-sans); font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--hs-ink-3);">E-Signatures</p>
        </div>
        <h2 class="mt-6 mb-16 text-lg text-center" style="color: var(--hs-ink-2); font-family: var(--bhh-sans); font-weight: 500;">
          Sign with the same care we build. Custom build agreements, change orders, and selections — signed in minutes, kept on file forever.
        </h2>
      </div>
    </div>
    <div class="grid grid-cols-1 gap-12 md:gap-10 md:grid-cols-2 max-w-4xl mx-auto">
      <div class="card" style="background: #fff; border: 1px solid var(--hs-rule);">
        <div class="card-body">
          <div class="text-center transition-all">
            <div class="inline-block p-4 mb-4 -mt-16 rounded-full" style="background: var(--bhh-dandelion);">
              <%= svg_icon('shield_check', class: 'w-10 h-10 text-[#092b49]') %>
            </div>
            <h3 class="mb-4 text-2xl font-semibold" style="font-family: var(--bhh-serif); font-style: italic; font-weight: 700; color: var(--hs-ink);">Secure & Sealed</h3>
            <p class="text-base" style="color: var(--hs-ink-2);">
              Every signature is verified, every document sealed with a certificate of completion. Your agreements are safe with us.
            </p>
          </div>
        </div>
      </div>
      <div class="card" style="background: #fff; border: 1px solid var(--hs-rule);">
        <div class="card-body">
          <div class="text-center transition-all">
            <div class="inline-block p-4 mb-4 -mt-16 rounded-full" style="background: var(--bhh-dandelion);">
              <%= svg_icon('devices', class: 'w-10 h-10 text-[#092b49]') %>
            </div>
            <h3 class="mb-4 text-2xl font-semibold" style="font-family: var(--bhh-serif); font-style: italic; font-weight: 700; color: var(--hs-ink);">Sign Anywhere</h3>
            <p class="text-base" style="color: var(--hs-ink-2);">
              Review and sign from any device. Whether at the design studio or on the jobsite, your documents are ready when you are.
            </p>
          </div>
        </div>
      </div>
      <div class="card" style="background: #fff; border: 1px solid var(--hs-rule);">
        <div class="card-body">
          <div class="text-center transition-all">
            <div class="inline-block p-4 mb-4 -mt-16 rounded-full" style="background: var(--bhh-dandelion);">
              <%= svg_icon('clock', class: 'w-10 h-10 text-[#092b49]') %>
            </div>
            <h3 class="mb-4 text-2xl font-semibold" style="font-family: var(--bhh-serif); font-style: italic; font-weight: 700; color: var(--hs-ink);">Minutes, Not Days</h3>
            <p class="text-base" style="color: var(--hs-ink-2);">
              No more printing, scanning, or mailing. Build agreements get signed in minutes, and the process starts the same day.
            </p>
          </div>
        </div>
      </div>
      <div class="card" style="background: #fff; border: 1px solid var(--hs-rule);">
        <div class="card-body">
          <div class="text-center transition-all">
            <div class="inline-block p-4 mb-4 -mt-16 rounded-full" style="background: var(--bhh-dandelion);">
              <%= svg_icon('home', class: 'w-10 h-10 text-[#092b49]') %>
            </div>
            <h3 class="mb-4 text-2xl font-semibold" style="font-family: var(--bhh-serif); font-style: italic; font-weight: 700; color: var(--hs-ink);">Built for Homebuilding</h3>
            <p class="text-base" style="color: var(--hs-ink-2);">
              Designed specifically for Brown Haven Homes workflows — build agreements, change orders, selections sign-offs, and more.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
